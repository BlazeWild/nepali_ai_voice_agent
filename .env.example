LLM_MODE=gemma_e2b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

OLLAMA_MODEL=gemma4:e2b-it-q4_K_M
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_PREDICT=180
OLLAMA_THINK=false

# High-VRAM-only: set LLM_MODE=gemma_12b and a pulled 12B tag, then measure
# concurrent STT + LLM VRAM before use. Keep OLLAMA_NUM_CTX at or below 2048.
# OLLAMA_MODEL=<your-12b-ollama-tag>

STT_BACKEND=indic_conformer
INDIC_CONFORMER_MODEL_DIR=../stt_research/models/indic-conformer-600m-multilingual-onnx
VAD_BACKEND=silero
VAD_THRESHOLD=0.5
VAD_SILENCE_DURATION_MS=600
VAD_MIN_SPEECH_MS=450
VAD_BARGE_IN_MS=350

USE_TTS=true
SHOW_TRANSCRIPTS=true
